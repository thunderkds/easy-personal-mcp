  "scenario": "K08_verifier_container",
  "steps": [
    {
      "cwds": [
        "<WORK>/proj"
      ],
      "op": "transcript"
    },
    {
      "op": "mkdir",
      "path": "<WORK>/proj"
    },
    {
      "op": "write",
      "path": "<NOWHERE>/.easy-verifier-reports/proj/evidence-report-20260101T000000-1Z.json",
      "text": "{\"schema_version\": 1, \"scope\": \"changes\", \"generated_at\": \"2026-01-10T15:00:00Z\", \"overall\": {\"abstained\": false, \"value\": 10, \"reason_code\": null}, \"dimensions\": [\"%CANARY%\"]}"
    },
    {
      "env": {
        "EASY_PERSONAL_VERIFIER_REPORTS": null
      },
      "label": "default container under HOME",
      "op": "ingest"
    },
    {
      "op": "write",
      "path": "<CASE>/vc/proj/evidence-report-20260101T000000-1Z.json",
      "text": "{\"schema_version\": 1, \"scope\": \"changes\", \"generated_at\": \"2026-01-10T15:00:00Z\", \"overall\": {\"abstained\": false, \"value\": 20, \"reason_code\": null}, \"dimensions\": [\"%CANARY%\"]}"
    },
    {
      "op": "write",
      "path": "<HOME>/config.yaml",
      "text": "verifier:\n  reports_dir: <CASE>/vc\n"
    },
    {
      "env": {
        "EASY_PERSONAL_VERIFIER_REPORTS": null
      },
      "label": "config.yaml verifier: reports_dir",
      "op": "ingest"
    },
    {
      "op": "write",
      "path": "<VERIFIER>/proj/evidence-report-20260101T000000-1Z.json",
      "text": "{\"schema_version\": 1, \"scope\": \"changes\", \"generated_at\": \"2026-01-10T15:00:00Z\", \"overall\": {\"abstained\": false, \"value\": 30, \"reason_code\": null}, \"dimensions\": [\"%CANARY%\"]}"
    },
    {
      "label": "env beats config",
      "op": "ingest"
    },
    {
      "op": "write",
      "path": "<HOME>/config.yaml",
      "text": "verifier:\n  reports_dir: ~/home-reports\n"
    },
    {
      "op": "write",
      "path": "<NOWHERE>/home-reports/proj/evidence-report-20260101T000000-1Z.json",
      "text": "{\"schema_version\": 1, \"scope\": \"changes\", \"generated_at\": \"2026-01-10T15:00:00Z\", \"overall\": {\"abstained\": false, \"value\": 40, \"reason_code\": null}, \"dimensions\": [\"%CANARY%\"]}"
    },
    {
      "env": {
        "EASY_PERSONAL_VERIFIER_REPORTS": null
      },
      "label": "config with ~",
      "op": "ingest"
    },
    {
      "op": "write",
      "path": "<VERIFIER>/proj/evidence-report-20260102T000000-1Z.json",
      "text": "{\"schema_version\": 3, \"scope\": \"changes\", \"generated_at\": \"2026-01-10T15:00:00Z\", \"overall\": {\"abstained\": false, \"value\": 86.5, \"reason_code\": null}, \"dimensions\": [\"%CANARY%\"]}"
    },
    {
      "label": "a newer unknown-schema file turns the project abstained",
      "op": "ingest"
    }
  ],
