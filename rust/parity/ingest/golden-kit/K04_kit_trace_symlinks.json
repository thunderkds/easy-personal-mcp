  "scenario": "K04_kit_trace_symlinks",
  "steps": [
    {
      "cwds": [
        "<WORK>/proj",
        "<WORK>/proj2"
      ],
      "op": "transcript"
    },
    {
      "op": "write",
      "path": "<WORK>/outside/real.jsonl",
      "text": "{\"timestamp\": \"2026-01-10T15:00:00Z\", \"tool_name\": \"Bash\", \"is_error\": false, \"summary\": \"%CANARY%\"}\n{\"timestamp\": \"2026-01-10T15:00:01Z\", \"tool_name\": \"Read\", \"is_error\": false, \"summary\": \"%CANARY%\"}\n"
    },
    {
      "op": "symlink",
      "path": "<WORK>/proj/memory/event-trace/L.jsonl",
      "target": "<WORK>/outside/real.jsonl"
    },
    {
      "op": "symlink",
      "path": "<WORK>/proj/memory/event-trace/B.jsonl",
      "target": "<WORK>/outside/missing.jsonl"
    },
    {
      "op": "write",
      "path": "<WORK>/outside/traces/T2.jsonl",
      "text": "{\"timestamp\": \"2026-01-10T15:00:00Z\", \"tool_name\": \"Bash\", \"is_error\": false, \"summary\": \"%CANARY%\"}\n"
    },
    {
      "op": "symlink",
      "path": "<WORK>/proj2/memory/event-trace",
      "target": "<WORK>/outside/traces"
    },
    {
      "label": "first run",
      "op": "ingest"
    },
    {
