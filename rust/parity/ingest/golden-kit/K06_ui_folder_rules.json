  "scenario": "K06_ui_folder_rules",
  "steps": [
    {
      "op": "write",
      "path": "<UI>/session-a.json",
      "text": "{\"id\":\"a\",\"status\":\"passed\",\"startedAt\":\"2026-01-10T15:00:00Z\",\"actions\":[1]}"
    },
    {
      "env": {
        "EASY_PERSONAL_UI_REPORTS": "<UI>"
      },
      "label": "env folder set: one session",
      "op": "ingest"
    },
    {
      "label": "env unset: wipes ui_sessions (status no data)",
      "op": "ingest"
    },
    {
      "env": {
        "EASY_PERSONAL_UI_REPORTS": "<UI>"
      },
      "label": "env folder set again: the row is back",
      "op": "ingest"
    },
    {
      "op": "mkdir",
      "path": "<CASE>/ui-empty"
    },
    {
      "env": {
        "EASY_PERSONAL_UI_REPORTS": "<CASE>/ui-empty"
      },
      "label": "existing empty folder: no wipe",
      "op": "ingest"
    },
    {
      "op": "write",
      "path": "<UI>/session-a.json",
      "text": "{\"id\":\"a\",\"status\":\"failed\",\"startedAt\":\"2026-01-10T15:00:00Z\",\"actions\":[1]}"
    },
    {
      "op": "write",
      "path": "<UI>/session-b.json",
      "text": "{\"id\":\"b\",\"status\":\"passed\",\"startedAt\":\"2026-01-10T15:00:00Z\",\"actions\":[1]}"
    },
    {
      "env": {
        "EASY_PERSONAL_UI_REPORTS": "<UI>"
      },
      "label": "a changed, b added: replace only",
      "op": "ingest"
    },
    {
      "op": "remove",
      "path": "<UI>/session-a.json"
    },
    {
      "env": {
        "EASY_PERSONAL_UI_REPORTS": "<UI>"
      },
      "label": "a's file removed: its row stays (no delete)",
      "op": "ingest"
    },
    {
      "env": {
        "EASY_PERSONAL_UI_REPORTS": "<CASE>/ui-missing"
      },
      "label": "missing folder: wipes",
      "op": "ingest"
    },
    {
      "op": "write",
      "path": "<CASE>/cfg-sessions/session-c.json",
      "text": "{\"id\":\"c\",\"status\":\"passed\",\"startedAt\":\"2026-01-10T15:00:00Z\",\"actions\":[1]}"
    },
    {
      "op": "write",
      "path": "<HOME>/config.yaml",
      "text": "# owner settings\nthresholds:\n  tool_calls: 5\nui:\n  reports_dir: <CASE>/cfg-sessions\nverifier:\n  reports_dir: <CASE>/v\n"
    },
    {
      "label": "env unset, config.yaml ui: reports_dir",
      "op": "ingest"
    },
    {
      "env": {
        "EASY_PERSONAL_UI_REPORTS": ""
      },
      "label": "env empty string: config is used",
      "op": "ingest"
    },
    {
      "env": {
        "EASY_PERSONAL_UI_REPORTS": "<UI>"
      },
      "label": "env set beats config",
      "op": "ingest"
    },
    {
      "op": "write",
      "path": "<NOWHERE>/ui-cfg/session-d.json",
      "text": "{\"id\":\"d\",\"status\":\"passed\",\"startedAt\":\"2026-01-10T15:00:00Z\",\"actions\":[1]}"
    },
    {
      "op": "write",
      "path": "<HOME>/config.yaml",
      "text": "# owner settings\nthresholds:\n  tool_calls: 5\nui:\n  reports_dir: ~/ui-cfg\nverifier:\n  reports_dir: <CASE>/v\n"
    },
    {
      "label": "config reports_dir with ~ (HOME is the nowhere folder)",
      "op": "ingest"
    },
    {
      "op": "write",
      "path": "<HOME>/config.yaml",
      "text": "ui:\n\treports_dir: <UI>\n"
    },
    {
      "label": "tab-indented value is not inside the section: wipes",
      "op": "ingest"
    },
    {
      "op": "write",
      "path": "<HOME>/config.yaml",
      "text": "ui: # note\n  reports_dir: <UI>  \n  other: 1\n"
    },
    {
      "label": "`ui:` with a comment, trailing spaces in the value",
      "op": "ingest"
    },
    {
      "op": "write",
      "path": "<HOME>/config.yaml",
      "text": "ui :\n  reports_dir: <UI>\n"
    },
    {
      "label": "`ui :` is another section: wipes",
      "op": "ingest"
    }
  ],
  "what": "ui: unset and missing folders wipe the table, an empty folder does not, replace without delete, env beats config, ~ and flat-file quirks"
}
