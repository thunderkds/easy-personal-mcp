{
  "runs": [
    {
      "argv": [
        "easy-personal",
        "schedule",
        "install"
      ],
      "before": [
        {
          "op": "systemctl",
          "present": true
        }
      ],
      "cmd_dir": "bin",
      "dirs": [
        "xdg",
        "xdg/systemd",
        "xdg/systemd/user"
      ],
      "env_extra": {},
      "exit_code": 0,
      "fake_systemctl": {
        "fail": null,
        "no_session": false,
        "on_path": true
      },
      "files": {
        "xdg/systemd/user/easy-personal-ingest.service": "[Unit]\nDescription=easy-personal ingest (copy new Claude Code usage metadata to the store)\n\n[Service]\nType=oneshot\nExecStart=<CMD> ingest\n",
        "xdg/systemd/user/easy-personal-ingest.timer": "[Unit]\nDescription=Run easy-personal ingest daily\n\n[Timer]\nOnCalendar=daily\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n"
      },
      "label": "install",
      "stderr": "empty",
      "stdout": "installed easy-personal-ingest.timer in <CASE>/xdg/systemd/user\n",
      "systemctl_calls": [
        "--user show-environment",
        "--user daemon-reload",
        "--user enable --now easy-personal-ingest.timer"
      ]
    },
    {
      "argv": [
        "easy-personal",
        "schedule",
        "remove"
      ],
      "before": [],
      "cmd_dir": "bin",
      "dirs": [
        "xdg",
        "xdg/systemd",
        "xdg/systemd/user"
      ],
      "env_extra": {},
      "exit_code": 1,
      "fake_systemctl": {
        "fail": "disable",
        "no_session": false,
        "on_path": true
      },
      "files": {
        "xdg/systemd/user/easy-personal-ingest.service": "[Unit]\nDescription=easy-personal ingest (copy new Claude Code usage metadata to the store)\n\n[Service]\nType=oneshot\nExecStart=<CMD> ingest\n",
        "xdg/systemd/user/easy-personal-ingest.timer": "[Unit]\nDescription=Run easy-personal ingest daily\n\n[Timer]\nOnCalendar=daily\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n"
      },
      "label": "disable fails",
      "stderr": "traceback: subprocess.CalledProcessError",
      "stdout": "",
      "systemctl_calls": [
        "--user disable --now easy-personal-ingest.timer"
      ]
    },
    {
      "argv": [
        "easy-personal",
        "schedule",
        "remove"
      ],
      "before": [],
      "cmd_dir": "bin",
      "dirs": [
        "xdg",
        "xdg/systemd",
        "xdg/systemd/user"
      ],
      "env_extra": {},
      "exit_code": 1,
      "fake_systemctl": {
        "fail": "daemon-reload",
        "no_session": false,
        "on_path": true
      },
      "files": {},
      "label": "final daemon-reload fails",
      "stderr": "traceback: subprocess.CalledProcessError",
      "stdout": "",
      "systemctl_calls": [
        "--user disable --now easy-personal-ingest.timer",
        "--user daemon-reload"
      ]
    },
    {
      "argv": [
        "easy-personal",
        "schedule",
        "remove"
      ],
      "before": [
        {
          "op": "systemctl",
          "present": false
        },
        {
          "op": "put",
          "path": "xdg/systemd/user/easy-personal-ingest.timer",
          "text": "stale\n"
        }
      ],
      "cmd_dir": "bin",
      "dirs": [
        "xdg",
        "xdg/systemd",
        "xdg/systemd/user"
      ],
      "env_extra": {},
      "exit_code": 1,
      "fake_systemctl": {
        "fail": null,
        "no_session": false,
        "on_path": false
      },
      "files": {
        "xdg/systemd/user/easy-personal-ingest.timer": "stale\n"
      },
      "label": "timer present, no systemctl",
      "stderr": "traceback: FileNotFoundError",
      "stdout": "",
      "systemctl_calls": []
    }
  ],
  "scenario": "F02_remove_fails",
  "what": "Python: traceback, exit 1; files stay when disable fails, are gone when the last daemon-reload fails"
}
